{
  "name": "@local/dsh-magpie-monitor",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Magpie Monitor for DeepSeek Harness: a sidebar panel showing live request routing (requested vs served model), usage totals, daily activity and provider account quotas from the local Magpie gateway.",
  "license": "MIT",
  "author": "msudustin",
  "homepage": "https://github.com/msudustin/dsh-magpie-monitor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msudustin/dsh-magpie-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/msudustin/dsh-magpie-monitor/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "magpie",
    "usage",
    "quota",
    "routing",
    "sidebar",
    "monitor"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test --test-force-exit \"test/*.test.js\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}